[Unit]
Description=Route Claude traffic into the Psiphon country guard
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/bin/claude-at --protect-raw @SOCKS@ @HTTP@ @GID@
ExecStart=/usr/sbin/nft -f /etc/claude-at/rules.nft

[Install]
WantedBy=multi-user.target
